{
  "name": "binge-watch-time",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-eslint": "^8.2.1",
    "babel-preset-stage-2": "^6.24.1",
    "db-migrate": "^0.10.5",
    "db-migrate-pg": "^1.5.2",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "eslint": "^4.18.2",
    "eslint-config-standard": "^11.0.0",
    "eslint-config-standard-react": "^5.0.0",
    "eslint-plugin-import": "^2.9.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-node": "^6.0.0",
    "eslint-plugin-promise": "^3.6.0",
    "eslint-plugin-react": "^7.6.1",
    "eslint-plugin-standard": "^3.0.1",
    "nodemon": "^1.15.1",
    "npm-run-all2": "^7.0.2",
    "react-app-rewired": "^1.4.1",
    "react-scripts": "1.1.1",
    "stylelint": "^9.0.0",
    "stylelint-config-standard": "^18.1.0",
    "stylelint-webpack-plugin": "^0.10.2"
  },
  "dependencies": {
    "axios": "^0.18.0",
    "bcrypt-nodejs": "^0.0.3",
    "classnames": "^2.2.5",
    "connected-react-router": "^4.5.0",
    "cookies": "^0.7.1",
    "ejs": "^2.5.7",
    "express": "^4.16.2",
    "foundation-sites": "^6.4.4-rc1",
    "helmet": "^3.11.0",
    "history": "^4.7.2",
    "house-rules": "^0.8.1",
    "informative": "^0.6.1",
    "js-cookie": "^2.2.0",
    "limits.js": "^0.1.4",
    "lodash": "^4.17.19",
    "mailgun-js": "^0.16.0",
    "moviedb": "^0.2.10",
    "mysql": "^2.15.0",
    "njwt": "^1.0.0",
    "normalizr": "^3.2.4",
    "object-fit-images": "^3.2.4",
    "pg": "^8.14.1",
    "react": "^16.2.0",
    "react-dom": "^16.2.1",
    "react-ga4": "^2.1.0",
    "react-redux": "^5.0.7",
    "react-router-dom": "^4.2.2",
    "redux": "^3.7.2",
    "redux-act": "^1.7.2",
    "sass": "^1.86.3",
    "uuid": "^3.2.1",
    "winston": "^2.4.0"
  },
  "scripts": {
    "postinstall": "yarn migrate up && rm -rf build-server && yarn build:server && yarn build:client:css && yarn build:client:js",
    "dev": "run-p dev:\\*",
    "dev:server": "nodemon --watch server server/index.js --exec 'yarn lint:server -c .eslintrc.dev.js && babel-node'",
    "dev:client": "yarn dev:client:js",
    "dev:client:js": "NODE_PATH=src react-app-rewired start",
    "dev:client:css": "yarn build:client:css && sass --watch --load-path=./src --load-path=./node_modules src:src --quiet-deps --silence-deprecation=import",
    "build:server": "babel server -d build-server",
    "build:client:js": "NODE_OPTIONS=--max_old_space_size=4096 GENERATE_SOURCEMAP=false NODE_PATH=src react-app-rewired build",
    "build:client:css": "sass --load-path=./src --load-path=./node_modules src:src --quiet-deps --silence-deprecation=import",
    "lint": "run-s lint:\\*",
    "lint:server": "ESLINT_MODE=node npx eslint 'server/**/*.js' --ignore-path '.gitignore' --ignore-pattern 'server/migrations/*'",
    "lint:client": "run-s lint:client:\\*",
    "lint:client:js": "npx eslint --ext .js --ignore-path .gitignore --ignore-pattern '/server/*' .",
    "lint:client:css": "stylelint 'src/scss/**/*.scss'",
    "test": "react-app-rewired test",
    "test:coverage": "yarn test -- --coverage",
    "start": "NODE_PATH=build-server NODE_ENV=production node build-server/index.js",
    "migrate": "npx db-migrate --config 'server/database.js' --migrations-dir 'server/migrations'"
  },
  "proxy": {
    "/api": {
      "target": "http://127.0.0.1:3001"
    }
  }
}
